{{- range concat (list "tpm" "tmux-open") .tmuxPlugins }}

[".tmux/plugins/{{ . }}"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/{{ . }}.git"
    refreshPeriod = "168h"
{{- end }}


{{- /* Release binaries into ~/.local/bin, from the `releases` table in
       .chezmoidata.toml. The latest tag comes from latest-release.sh (cached
       for a week); a tool whose tag can't be found is skipped this time. */}}
{{- $rust := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch }}
{{- $rustos := get (dict "linux" "unknown-linux-musl" "darwin" "apple-darwin") .chezmoi.os }}
{{- if and $rust $rustos }}
{{- $os := .chezmoi.os }}
{{- $platform := printf "%s/%s" .chezmoi.os .chezmoi.arch }}
{{- $vars := dict
      "{os}" .chezmoi.os
      "{Os}" (title .chezmoi.os)
      "{go}" .chezmoi.arch
      "{rust}" $rust
      "{rustos}" $rustos
      "{glow}" (get (dict "amd64" "x86_64" "arm64" "arm64") .chezmoi.arch) }}
{{- $latest := includeTemplate "latest-release.sh" . }}
{{- range .releases }}
{{-   $platforms := splitList " " (index . 2) }}
{{-   if or (has $os $platforms) (has $platform $platforms) }}
{{-     $repo := index . 1 }}
{{-     $tag := "" }}
{{-     if contains "@" $repo }}
{{-       $tag = splitList "@" $repo | last }}
{{-       $repo = splitList "@" $repo | first }}
{{-     else }}
{{-       $tag = output "sh" "-c" $latest "sh" $repo | trim }}
{{-     end }}
{{-     if $tag }}
{{-       $file := index . 3 }}
{{-       $path := index . 4 }}
{{-       range $k, $v := merge (dict "{tag}" $tag "{ver}" (trimPrefix "v" $tag)) $vars }}
{{-         $file = replace $k $v $file }}
{{-         $path = replace $k $v $path }}
{{-       end }}

[".local/bin/{{ index . 0 }}"]
    type = "archive-file"
    url = "https://github.com/{{ $repo }}/releases/download/{{ $tag }}/{{ $file }}"
    path = "{{ $path }}"
    executable = true
{{-     end }}
{{-   end }}
{{- end }}
{{- end }}
