{{- range concat (list "tpm" "tmux-open") .tmuxPlugins }}

[".tmux/plugins/{{ . }}"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/{{ . }}.git"
    refreshPeriod = "168h"
{{- end }}

{{- /* zellij: prebuilt release binary. Debian/Ubuntu packages are stale, and
       brew builds it from source on older Intel Macs */}}
{{- $zellijArch := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch }}
{{- $zellijOS := get (dict "linux" "unknown-linux-musl" "darwin" "apple-darwin") .chezmoi.os }}
{{- if and $zellijArch $zellijOS }}

[".local/bin/zellij"]
    type = "archive-file"
    url = "https://github.com/zellij-org/zellij/releases/latest/download/zellij-{{ $zellijArch }}-{{ $zellijOS }}.tar.gz"
    path = "zellij"
    executable = true
    refreshPeriod = "168h"
{{- end }}
