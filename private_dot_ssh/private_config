# Managed by chezmoi. Machine-specific hosts (work servers and the like) go in
# ~/.ssh/config.local, which is read first and is not in the public repo.
Include ~/.ssh/config.local

# Reachable from anywhere
Host atom east minecraft ro west
    HostName %h.handled.it

# Tailscale only, named without the tailnet suffix. Connect directly when this
# machine can resolve the name (on the tailnet right now); otherwise go
# through west, which can.
Match host blox1,blox2,macmini,t420s !exec "~/.local/bin/resolves %h"
    ProxyJump west

# My own machines: same user everywhere, and the agent comes along
Host atom east minecraft ro west blox1 blox2 macmini t420s
    User russell
    ForwardAgent yes

# GitHub as the personal account (rstad), whichever other keys the agent
# holds: offer only rstad's keys (Bitwarden on the personal laptop, the rstad
# key in 1Password on the work laptop). .gitconfig sends rstad/* repos here.
Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/github-personal-bitwarden.pub
    IdentityFile ~/.ssh/github-personal-1password.pub
    IdentitiesOnly yes

Host *
    ServerAliveInterval 60
