{{- /* Machines without Tailscale (work ones) reach the tailnet-only hosts through west */ -}}
{{- $onTailnet := or (lookPath "tailscale") (stat "/Applications/Tailscale.app") -}}
# Managed by chezmoi. Machine-specific hosts (work servers and the like) go in
# ~/.ssh/config.local, which is read first and is not in the public repo.
Include ~/.ssh/config.local

# Reachable from anywhere
Host atom east minecraft ro west
    HostName %h.handled.it
{{- if not $onTailnet }}

# Tailscale only, and this machine isn't on the tailnet: go through west,
# which resolves the short names
Host blox1 blox2 macmini t420s
    ProxyJump west
{{- end }}

# My own machines: same user everywhere, and the agent comes along
Host atom east minecraft ro west blox1 blox2 macmini t420s
    User russell
    ForwardAgent yes

Host *
    ServerAliveInterval 60
