[user]
	name = Russell Stadler
	email = {{ .email }}
[gpg]
	format = ssh
[gpg "ssh"]
	# Sign with the ssh agent key that matches the commit email (the password
	# manager's agent locally, or the forwarded one over ssh)
	defaultKeyCommand = {{ .chezmoi.homeDir }}/.local/bin/git-signing-key
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- if lookPath "gh" }}
[credential "https://github.com"]
	helper =
	helper = !{{ lookPath "gh" }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ lookPath "gh" }} auth git-credential
{{- end }}
[pull]
	rebase = false
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
