{{- /* The only question. A gmail or GitHub noreply address means personal (Bitwarden);
       anything else means work (1Password). Re-ask with `chezmoi init --prompt`. */ -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $personal := or (hasSuffix "@gmail.com" (lower $email)) (hasSuffix "@users.noreply.github.com" (lower $email)) -}}
{{- /* Personal commits use the GitHub noreply address, not the gmail */ -}}
{{- if $personal }}{{ $email = "3325739+rstad@users.noreply.github.com" }}{{ end -}}

[data]
    email = {{ $email | quote }}
    personal = {{ $personal }}
    passwordManager = {{ ternary "bitwarden" "1password" $personal | quote }}

[edit]
    command = "vi"
