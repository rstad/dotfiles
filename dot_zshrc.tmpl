typeset -U path
path=(~/bin ~/.local/bin $path)

if command -v vim >/dev/null; then export EDITOR=vim; else export EDITOR=vi; fi
export VISUAL=$EDITOR
[[ -n $LANG ]] || export LANG=en_US.UTF-8

# Inside ssh, point at the stable symlink to the forwarded agent that
# ~/.ssh/rc maintains, so long-lived tmux/zellij sessions survive reconnects.
# Locally, use the {{ .passwordManager }} ssh agent.
if [[ -n $SSH_CONNECTION ]]; then
  # The link follows the newest login, so it dies if that connection closes
  # while an older one is still up. Before each prompt, if the agent is gone,
  # repoint the link at the newest forwarded socket that still answers.
  _agent_link_check() {
    [[ -S $SSH_AUTH_SOCK ]] && return
    local sock
    for sock in /tmp/ssh-*/agent.*(N=Uom); do
      SSH_AUTH_SOCK=$sock ssh-add -l >/dev/null 2>&1
      (( $? == 2 )) && continue  # 2: no agent listening
      ln -sf $sock ~/.ssh/agent.sock
      break
    done
    [[ -S ~/.ssh/agent.sock ]] && export SSH_AUTH_SOCK=~/.ssh/agent.sock
  }
  export SSH_AUTH_SOCK=~/.ssh/agent.sock
  _agent_link_check
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _agent_link_check
else
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) (eq .passwordManager "1password") }}
  # WSL: 1Password's agent is a Windows pipe. Bridge it to a socket here with
  # socat (apt) and npiperelay.exe (winget), unless the bridge is already up.
  if ! pgrep -u $UID -f "UNIX-LISTEN:$HOME/.1password/agent.sock" >/dev/null; then
    if ! command -v npiperelay.exe >/dev/null; then
      print -u2 "ssh agent: npiperelay.exe not found, so ssh can't reach 1Password." \
        "In PowerShell: winget install albertony.npiperelay, then restart Windows Terminal."
    elif ! command -v socat >/dev/null; then
      print -u2 "ssh agent: socat not found, so ssh can't reach 1Password. Run: sudo apt install socat"
    else
      mkdir -p -m 700 ~/.1password
      (setsid socat UNIX-LISTEN:$HOME/.1password/agent.sock,fork,unlink-early \
        EXEC:"npiperelay.exe -ei -s //./pipe/openssh-ssh-agent",nofork &) >/dev/null 2>&1
      for i in {1..20}; do [[ -S ~/.1password/agent.sock ]] && break; sleep 0.05; done
    fi
  fi
{{- end }}
  for sock in \
{{- if .personal }}
    ~/.bitwarden-ssh-agent.sock \
    ~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock \
    ~/snap/bitwarden/current/.bitwarden-ssh-agent.sock \
{{- else }}
    ~/.1password/agent.sock \
    ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock \
{{- end }}
    ; do
    if [[ -S $sock ]]; then export SSH_AUTH_SOCK=$sock; break; fi
  done
fi

# Use emacs keybindings even if our EDITOR is set to vi
bindkey -e

HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt histignorealldups sharehistory extendedhistory histignorespace

# Completion. ~/.local/share/zsh/site-functions holds the ones
# run_after_zsh-completions.sh generates for the release binaries.
fpath=(~/.local/share/zsh/site-functions $fpath)
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' verbose true
if command -v dircolors >/dev/null; then
  eval "$(dircolors -b)"
  zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
fi
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,command'

if ls --version 2>&1 | grep -qi gnu; then
  alias ls='ls --color=auto -Fh'
else
  alias ls='ls -GhF'
fi
# ls stays ls; the shortcuts use eza where it's installed (its flags differ)
if command -v eza >/dev/null; then
  alias ll='eza -l --git' la='eza -la --git' lt='eza --tree --level=2'
else
  alias ll='ls -l' la='ls -la'
fi

# fzf: Ctrl-T inserts a file, Alt-C cds, and Ctrl-R searches history where
# atuin (below) doesn't take it; file lists come from fd, so .gitignored
# files are skipped
if command -v fzf >/dev/null; then
  if command -v fd >/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
  eval "$(fzf --zsh 2>/dev/null)"
fi
# zoxide: `z part-of-dir` jumps to the best match of directories visited before
if command -v zoxide >/dev/null; then eval "$(zoxide init zsh)"; fi
# atuin: Ctrl-R searches its history database (after fzf, so it gets Ctrl-R);
# the up arrow stays plain zsh history
if command -v atuin >/dev/null; then eval "$(atuin init zsh --disable-up-arrow)"; fi
# tldr (tealdeer): read its config from ~/.config on Macs too
export TEALDEER_CONFIG_DIR=~/.config/tealdeer
# Man pages highlighted by bat, still paged by less. MANROFFOPT=-c makes
# groff use plain overstrikes, which col strips, instead of escape codes.
if command -v bat >/dev/null; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT=-c
fi

if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
else
  PROMPT='%F{blue}%~%f %# '
fi

# Machine-specific (work stuff, secrets) goes here, not in the public repo
if [[ -f ~/.zshrc.local ]]; then source ~/.zshrc.local; fi
