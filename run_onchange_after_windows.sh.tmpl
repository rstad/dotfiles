{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
#!/bin/sh
# WSL: WezTerm, ssh.exe and zellij run on the Windows side, so copy their
# configs there. Re-runs when any of them changes (zellij's is rendered into
# this script below, so a change to it changes the script):
#   {{ include "dot_wezterm.lua" | sha256sum }}
#   {{ include "private_dot_ssh/private_config" | sha256sum }}
#   {{ include "private_dot_ssh/github-personal-bitwarden.pub" | sha256sum }}
#   {{ include "private_dot_ssh/github-personal-1password.pub" | sha256sum }}
winhome=$(cd /mnt/c && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
if [ -z "$winhome" ]; then
    echo "windows: could not find the Windows home, skipping" >&2
    exit 0
fi
winhome=$(wslpath "$winhome")

cp "{{ .chezmoi.sourceDir }}/dot_wezterm.lua" "$winhome/.wezterm.lua"

# ssh.exe can't run the 'resolves' check, and this machine isn't on the
# tailnet, so the Tailscale hosts always go through west. A config that
# chezmoi didn't write becomes config.local, which the new one includes.
cfg=$winhome/.ssh/config
mkdir -p "$winhome/.ssh"
if [ -f "$cfg" ] && ! grep -q 'Managed by chezmoi' "$cfg"; then
    if [ -e "$cfg.local" ]; then
        mv "$cfg" "$cfg.pre-chezmoi"
        echo "windows: saved the old ssh config as $cfg.pre-chezmoi" >&2
    else
        mv "$cfg" "$cfg.local"
        echo "windows: moved the old ssh config to $cfg.local; trim it to what's still needed" >&2
    fi
fi
{
    echo "# Managed by chezmoi (written from WSL). Windows copy of ~/.ssh/config:"
    echo "# Tailscale hosts always go through west. Local additions: config.local"
    sed -e '/^#/d' \
        -e '/^Match host .* !exec /{s/^Match host \([^ ]*\) .*/Host \1/;s/,/ /g;}' \
        "{{ .chezmoi.sourceDir }}/private_dot_ssh/private_config"
} > "$cfg"
# public keys named by IdentityFile in that config
cp "{{ .chezmoi.sourceDir }}"/private_dot_ssh/github-personal-*.pub "$winhome/.ssh/"

# Native Windows zellij (installed by hand, e.g. the .msi) reads
# %APPDATA%\Zellij\config\config.kdl. Same template as ~/.config/zellij,
# plus the window settings and wsl.exe as the pane shell.
appdata=$(cd /mnt/c && cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r')
case $appdata in
    '' | %*) echo "windows: could not find %APPDATA%, skipping the zellij config" >&2 ;;
    *)
        zdir=$(wslpath "$appdata")/Zellij/config
        mkdir -p "$zdir"
        cat > "$zdir/config.kdl" <<'ZELLIJ_CONFIG_END'
{{ includeTemplate "dot_config/zellij/config.kdl.tmpl" (merge (dict "zellijWindows" true) .) }}
ZELLIJ_CONFIG_END
        ;;
esac
{{- end }}
