{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
#!/bin/sh
# WSL: WezTerm runs on the Windows side, so copy its config to the Windows home.
# Re-runs when the config changes: {{ include "dot_wezterm.lua" | sha256sum }}
winhome=$(cd /mnt/c && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
if [ -z "$winhome" ]; then
    echo "wezterm: could not find the Windows home, skipping" >&2
    exit 0
fi
cp "{{ .chezmoi.sourceDir }}/dot_wezterm.lua" "$(wslpath "$winhome")/.wezterm.lua"
{{- end }}
